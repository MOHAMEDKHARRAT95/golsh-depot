{
  // Configuration Cloudflare. La base D1 et l'espace photos KV sont créés
  // automatiquement au premier déploiement (pas d'identifiant à renseigner).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golsh",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "golsh-depot-db" }],
  "kv_namespaces": [{ "binding": "PHOTOS" }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
