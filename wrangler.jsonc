{
  "name": "golsh",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "golsh-depot-db" }],
  "kv_namespaces": [{ "binding": "PHOTOS" }],
  "observability": { "enabled": true }
}
